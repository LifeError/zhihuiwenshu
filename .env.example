# ============================================================
# .env.example — 复制为 .env 后填入实际值
# ============================================================

# ======================== Docker 构建选项 ========================
# USE_GPU=false   # 默认 CPU；GPU 设为 true

# ======================== 服务端口 ========================
IMPORT_PORT=8000
QUERY_PORT=8001

# ======================== 运行设备 ========================
# CPU 默认；GPU 改为: BGE_DEVICE=cuda:0  BGE_RERANKER_DEVICE=cuda:0  BGE_FP16=1  BGE_RERANKER_FP16=1
BGE_DEVICE=cpu
BGE_RERANKER_DEVICE=cpu
BGE_FP16=0
BGE_RERANKER_FP16=0

# ======================== 模型路径（宿主机） ========================
# 如果模型不在默认位置，修改为你的实际路径
BGE_M3_PATH=/path/to/your/models/bge-m3
BGE_RERANKER_LARGE=/path/to/your/models/bge-reranker-large

# ======================== LLM ========================
OPENAI_API_KEY=sk-your-api-key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DEFAULT_MODEL=qwen-flash
VL_MODEL=qwen3-vl-flash-2025-10-15
LLM_DEFAULT_TEMPERATURE=0.1

# ======================== Milvus ========================
MILVUS_URL=http://your-milvus-host:19530
MILVUS_USER=root
MILVUS_PASSWORD=your-milvus-password
CHUNKS_COLLECTION=kb_chunks
ITEM_NAME_COLLECTION=kb_item_names
EMBEDDING_DIM=1024

# ======================== MongoDB ========================
MONGO_URL=mongodb://your-mongo-host:27017
MONGO_DB_NAME=kb

# ======================== MinIO ========================
MINIO_ENDPOINT=your-minio-host:9000
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_BUCKET_NAME=knowledge-base-files
MINIO_IMG_DIR=/upload-images
MINIO_SECURE=False

# ======================== Neo4j ========================
NEO4J_URI=bolt://your-neo4j-host:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# ======================== MinerU ========================
MINERU_API_TOKEN=your-mineru-api-token
MINERU_BASE_URL=https://mineru.net/api/v4
MD_ROOT_DIR=./temp-files/

# ======================== MCP ========================
MCP_DASHSCOPE_BASE_URL_STREAMABLE=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp

# ======================== RAGAs 评估 ========================
EVALUATION_LLM_MODEL=qwen3-max
EVALUATION_LLM_TEMPERATURE=0.0
RETRIEVAL_TOP_K=5

# ======================== 日志 ========================
LOG_CONSOLE_ENABLE=True
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_ENABLE=True
LOG_FILE_LEVEL=INFO
LOG_FILE_RETENTION=7 days

# ======================== MinerU 离线配置 ========================
MINERU_MODEL_SOURCE=modelscope
MODELSCOPE_OFFLINE=1
MODELSCOPE_CACHE=/tmp/modelscope_cache
HF_HOME=/tmp/huggingface_cache
